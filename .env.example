# Copy this file to .env.production (or .env for local dev) and fill in real values.
# Never commit the filled-in file — .gitignore already excludes it.

# Required: Deriv app id — drives OAuth login/sign-up and WebSocket connections.
# Register one at https://developers.deriv.com/dashboard/
NEXT_PUBLIC_DERIV_APP_ID=
NEXT_PUBLIC_DERIV_REDIRECT_URI=

# Optional: in-app display name and whether to show it next to the logo.
NEXT_PUBLIC_DERIV_APP_NAME=
NEXT_PUBLIC_DERIV_SHOW_APP_NAME=true

# Optional: affiliate/partner referral link, appended on OAuth. Sensitive —
# treat like a credential, set only in your host's env vars.
NEXT_PUBLIC_DERIV_REFERRAL_LINK=

NEXT_PUBLIC_DERIV_OAUTH_SCOPES=trade
NEXT_PUBLIC_DERIV_ENV=production
NEXT_PUBLIC_FONT_FAMILY=Inter

# Optional: URL of the companion bot builder app (winindex-main), shown as a
# header link. Defaults to a same-origin /bot path. Set to "none" to hide it.
NEXT_PUBLIC_BOT_BUILDER_URL=
